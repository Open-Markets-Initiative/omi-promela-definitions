  :: daily_disclosed_rfr_message_at < 14 -> assert(daily_disclosed_rfr_message_read.disclosure_date[daily_disclosed_rfr_message_at] == daily_disclosed_rfr_message_written.disclosure_date[daily_disclosed_rfr_message_at]); daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
