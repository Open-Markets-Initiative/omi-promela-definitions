/* ---- Stock Directory Message: 36 bytes --------------------------------------- */

/* At the start of each trading day, NASDAQ PSX disseminates stock directory messages for all active symbols in its market center system. */
typedef StockDirectoryMessage {
  byte tracking_number[2];
  byte timestamp[6];
  byte stock[8];
  byte market_category;
  byte financial_status_indicator;
  byte round_lot_size[4];
