  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: pattern == 0 -> fill_emissions_issue_closing_message(emissions_issue_closing_message_sent, 0)
  :: pattern == 1 -> fill_emissions_issue_closing_message(emissions_issue_closing_message_sent, 32)
  :: pattern == 2 -> fill_emissions_issue_closing_message(emissions_issue_closing_message_sent, 255)
  :: else -> ramp_emissions_issue_closing_message(emissions_issue_closing_message_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_emissions_issue_closing_message(emissions_issue_closing_message_sent);
    assert(at == 107);
    at = 0;
    decode_emissions_issue_closing_message(emissions_issue_closing_message_got);
    assert(at == 107);
    equal_emissions_issue_closing_message(emissions_issue_closing_message_got, emissions_issue_closing_message_sent)
  }
}

