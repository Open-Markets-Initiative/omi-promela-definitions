  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_90_day[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_180_day[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_record.end_keyword = daily_disclosed_rfr_message_value;
  skip
}

/* each byte of Daily Disclosed Rfr Message set to where it lies, so a field read out of place says so */
inline ramp_daily_disclosed_rfr_message(daily_disclosed_rfr_message_record, daily_disclosed_rfr_message_base) {
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 8 -> daily_disclosed_rfr_message_record.base_date[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 0 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 2 -> daily_disclosed_rfr_message_record.disclosure_type[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 8 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
