/* ---- Bonds Order Filled Message: 218 bytes ----------------------------------- */

/* Bonds Order Filled. Trade prints for KTB, Baby Bonds, and General Bonds. */
typedef BondsOrderFilledMessage {
  byte message_sequence_number[8];
  byte board_id[2];
  byte session_id[2];
  byte isin_code[12];
  byte processing_time_of_trading_system[12];
  byte trading_price[11];
  byte trading_volume[10];
  byte trading_date[8];
  byte trading_value[22];
  byte bond_yield[13];
  byte opening_price[11];
  byte todays_high[11];
  byte todays_low[11];
  byte yield_opening_price[13];
  byte yield_todays_high[13];
  byte yield_todays_low[13];
  byte accumulated_trading_volume[15];
  byte accumulated_trading_value[22];
  byte settlement_date[8];
  byte end_keyword
};

int bonds_order_filled_message_at;

/* every byte of Bonds Order Filled Message set to one value */
inline fill_bonds_order_filled_message(bonds_order_filled_message_record, bonds_order_filled_message_value) {
  bonds_order_filled_message_at = 0;
  do
  :: bonds_order_filled_message_at < 8 -> bonds_order_filled_message_record.message_sequence_number[bonds_order_filled_message_at] = bonds_order_filled_message_value; bonds_order_filled_message_at = bonds_order_filled_message_at + 1
  :: else -> break
  od;
  bonds_order_filled_message_at = 0;
  do
  :: bonds_order_filled_message_at < 2 -> bonds_order_filled_message_record.board_id[bonds_order_filled_message_at] = bonds_order_filled_message_value; bonds_order_filled_message_at = bonds_order_filled_message_at + 1
