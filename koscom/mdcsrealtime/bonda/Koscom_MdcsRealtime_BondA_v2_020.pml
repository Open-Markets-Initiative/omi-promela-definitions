/* one checking process, chosen nondeterministically, so every one of them runs */
init {
  if
  :: run check_polling_data_message()
  :: run check_krx_index_message()
  :: run check_krx_estimated_index_message()
  :: run check_global_index_message()
  :: run check_bond_prime_index_message()
  :: run check_bond_ktb_index_message()
  :: run check_bond_ktb_index_term_structure_message()
  :: run check_bond_index_krx_message()
  :: run check_market_operation_ts_message()
  :: run check_market_operation_schedule_message()
  :: run check_issue_closing_message()
  :: run check_member_firm_sanctions_message()
  :: run check_regular_bonds_ktb_quote_message()
  :: run check_bonds_order_filled_message()
  :: run check_general_bonds_ktb_order_filled_plus_quote_message()
  :: run check_bonds_negotiated_trade_data_message()
  :: run check_repo_negotiated_trade_data_message()
  :: run check_bonds_batch_data_message()
  :: run check_repo_batch_data_message()
  :: run check_issue_event_message()
  :: run check_corporate_bonds_reference_message()
  :: run check_regular_bonds_installment_repayment_date_message()
  :: run check_repo_classification_data_message()
  :: run check_repo_trade_availability_per_term_message()
  :: run check_retail_bonds_type_code_message()
  :: run check_baby_bonds_reporting_market_yield_message()
  :: run check_ktb_confirmed_info_for_wit_message()
  :: run check_ktb_short_term_yield_message()
  :: run check_ktb_average_yield_message()
  :: run check_bonds_credit_rating_information_message()
  :: run check_regular_bonds_disclosure_basic_exchange_rate_message()
  :: run check_investor_activities_per_bond_types_message()
  :: run check_bonds_isin_issue_information_message()
  :: run check_bonds_isin_information_text_message()
  :: run check_baby_bonds_quote_message()
  :: run check_repo_quote_message()
  :: run check_bonds_total_remaining_volume_on_quotes_message()
  :: run check_baby_bonds_order_filled_plus_quote_message()
  :: run check_repo_order_filled_plus_quote_message()
  fi
}
