  :: else -> ramp_derivatives_quote_five_levels_message(derivatives_quote_five_levels_message_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_derivatives_quote_five_levels_message(derivatives_quote_five_levels_message_sent);
    assert(at == 319);
    at = 0;
    decode_derivatives_quote_five_levels_message(derivatives_quote_five_levels_message_got);
    assert(at == 319);
    equal_derivatives_quote_five_levels_message(derivatives_quote_five_levels_message_got, derivatives_quote_five_levels_message_sent)
  }
}

