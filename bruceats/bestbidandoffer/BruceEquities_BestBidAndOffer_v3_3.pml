/* ---- Quotation Message: 42 bytes --------------------------------------------- */

/* BBBO will broadcast a real-time update every time that the system's best bid and offer quote is updated during the trading day. */
typedef QuotationMessage {
  byte stock_locate[2];
  byte timestamp[8];
  byte stock[8];
  byte best_bid_price[8];
  byte best_bid_size[4];
  byte best_offer_price[8];
  byte best_offer_size[4]
};

int quotation_message_at;

/* every byte of Quotation Message set to one value */
inline fill_quotation_message(quotation_message_record, quotation_message_value) {
  quotation_message_at = 0;
  do
  :: quotation_message_at < 2 -> quotation_message_record.stock_locate[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.timestamp[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.stock[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.best_bid_price[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 4 -> quotation_message_record.best_bid_size[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.best_offer_price[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 4 -> quotation_message_record.best_offer_size[quotation_message_at] = quotation_message_value; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  skip
}

/* each byte of Quotation Message set to where it lies, so a field read out of place says so */
inline ramp_quotation_message(quotation_message_record, quotation_message_base) {
  quotation_message_at = 0;
  do
  :: quotation_message_at < 2 -> quotation_message_record.stock_locate[quotation_message_at] = (quotation_message_base + 0 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.timestamp[quotation_message_at] = (quotation_message_base + 2 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.stock[quotation_message_at] = (quotation_message_base + 10 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.best_bid_price[quotation_message_at] = (quotation_message_base + 18 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 4 -> quotation_message_record.best_bid_size[quotation_message_at] = (quotation_message_base + 26 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
  :: quotation_message_at < 8 -> quotation_message_record.best_offer_price[quotation_message_at] = (quotation_message_base + 30 + quotation_message_at + 1) % 256; quotation_message_at = quotation_message_at + 1
  :: else -> break
  od;
  quotation_message_at = 0;
  do
