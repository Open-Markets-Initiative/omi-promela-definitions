/* ---- Sequenced Message Header: 9 bytes --------------------------------------- */

/* Time and type carried ahead of every sequenced Itch message */
typedef SequencedMessageHeader {
  byte timestamp[8];
  byte message_type
};

int sequenced_message_header_at;

