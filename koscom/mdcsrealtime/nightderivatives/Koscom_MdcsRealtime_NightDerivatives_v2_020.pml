  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.indexed_interest_rate[daily_disclosed_rfr_message_at] = wire[at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
