  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 14 -> daily_disclosed_rfr_message_record.disclosure_date[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 10 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
