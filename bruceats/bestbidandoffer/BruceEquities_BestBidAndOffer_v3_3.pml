/* what was read of Quotation Message is what was written, byte for byte */
inline equal_quotation_message(quotation_message_read, quotation_message_written) {
  quotation_message_at = 0;
  do
  :: quotation_message_at < 2 -> assert(quotation_message_read.stock_locate[quotation_message_at] == quotation_message_written.stock_locate[quotation_message_at]); quotation_message_at = quotation_message_at + 1
