  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 14 -> wire[at] = daily_disclosed_rfr_message_record.disclosure_date[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 9 -> wire[at] = daily_disclosed_rfr_message_record.rfr[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> wire[at] = daily_disclosed_rfr_message_record.indexed_interest_rate[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> wire[at] = daily_disclosed_rfr_message_record.interest_rate_30_day[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> wire[at] = daily_disclosed_rfr_message_record.interest_rate_90_day[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> wire[at] = daily_disclosed_rfr_message_record.interest_rate_180_day[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  wire[at] = daily_disclosed_rfr_message_record.end_keyword; at = at + 1;
  skip
}

/* Daily Disclosed Rfr Message off the wire, 82 bytes from where the cursor stands */
inline decode_daily_disclosed_rfr_message(daily_disclosed_rfr_message_record) {
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 8 -> daily_disclosed_rfr_message_record.base_date[daily_disclosed_rfr_message_at] = wire[at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
