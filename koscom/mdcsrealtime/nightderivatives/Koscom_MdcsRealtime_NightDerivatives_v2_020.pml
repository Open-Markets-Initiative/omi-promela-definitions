/* one checking process, chosen nondeterministically, so every one of them runs */
init {
  if
  :: run check_polling_data_message()
  :: run check_derivatives_quote_five_levels_message()
  :: run check_derivatives_quote_ten_levels_message()
  :: run check_derivatives_snapshot_five_levels_message()
  :: run check_derivatives_snapshot_ten_levels_message()
  :: run check_derivatives_order_filled_message()
  :: run check_derivatives_order_filled_plus_quote_five_levels_message()
  :: run check_derivatives_order_filled_plus_quote_ten_levels_message()
  :: run check_derivatives_market_operation_ts_plus_quote_five_levels_message()
  :: run check_derivatives_market_operation_ts_plus_quote_ten_levels_message()
  :: run check_derivatives_negotiated_trade_message()
  :: run check_derivatives_market_operation_ts_message()
  :: run check_derivatives_issue_closing_message()
  :: run check_derivatives_market_operation_schedule_message()
  :: run check_derivatives_dynamic_upper_lower_limit_message()
  :: run check_derivatives_price_limit_range_increase_message()
  :: run check_derivatives_quantity_allocation_message()
  :: run check_derivatives_group_order_acceptance_halt_message()
  :: run check_derivatives_batch_data_message()
  :: run check_equity_derivatives_adjustment_details_message()
  :: run check_commodity_futures_settlement_reference_ktb_message()
  :: run check_derivatives_investor_activities_message()
  :: run check_derivatives_open_interest_message()
  :: run check_futures_settled_price_message()
  :: run check_options_base_price_of_clearing_margins_message()
  :: run check_options_implied_volatility_message()
  :: run check_options_sensitivity_message()
  :: run check_commodity_futures_spot_settlement_reference_message()
  :: run check_daily_disclosed_rfr_message()
  fi
}
