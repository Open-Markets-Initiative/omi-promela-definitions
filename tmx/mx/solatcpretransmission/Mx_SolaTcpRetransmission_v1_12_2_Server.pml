  circuit_assurance_message_at = 0;
  do
  :: circuit_assurance_message_at < 6 -> circuit_assurance_message_record.time[circuit_assurance_message_at] = (circuit_assurance_message_base + 12 + circuit_assurance_message_at + 1) % 256; circuit_assurance_message_at = circuit_assurance_message_at + 1
  :: else -> break
  od;
  skip
}

/* Circuit Assurance Message to the wire, 18 bytes from where the cursor stands */
