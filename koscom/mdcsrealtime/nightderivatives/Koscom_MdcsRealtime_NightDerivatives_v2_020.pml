  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 9 -> daily_disclosed_rfr_message_record.rfr[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 24 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.indexed_interest_rate[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 33 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_30_day[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 45 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_90_day[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 57 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_180_day[daily_disclosed_rfr_message_at] = (daily_disclosed_rfr_message_base + 69 + daily_disclosed_rfr_message_at + 1) % 256; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_record.end_keyword = (daily_disclosed_rfr_message_base + 81 + 1) % 256;
  skip
}

/* Daily Disclosed Rfr Message to the wire, 82 bytes from where the cursor stands */
inline encode_daily_disclosed_rfr_message(daily_disclosed_rfr_message_record) {
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 8 -> wire[at] = daily_disclosed_rfr_message_record.base_date[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 2 -> wire[at] = daily_disclosed_rfr_message_record.disclosure_type[daily_disclosed_rfr_message_at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
