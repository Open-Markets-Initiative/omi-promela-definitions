proctype check_after_hours_block_trade_trade_capture_report_confirmation_message() {
  AfterHoursBlockTradeTradeCaptureReportConfirmationMessage after_hours_block_trade_trade_capture_report_confirmation_message_sent;
  AfterHoursBlockTradeTradeCaptureReportConfirmationMessage after_hours_block_trade_trade_capture_report_confirmation_message_got;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: pattern == 0 -> fill_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_sent, 0)
  :: pattern == 1 -> fill_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_sent, 32)
  :: pattern == 2 -> fill_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_sent, 255)
  :: else -> ramp_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_sent);
    assert(at == 190);
    at = 0;
    decode_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_got);
    assert(at == 190);
    equal_after_hours_block_trade_trade_capture_report_confirmation_message(after_hours_block_trade_trade_capture_report_confirmation_message_got, after_hours_block_trade_trade_capture_report_confirmation_message_sent)
  }
}

/* Message Tail: encoded, read back, and compared */
proctype check_message_tail() {
  MessageTail message_tail_sent;
  MessageTail message_tail_got;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: pattern == 0 -> fill_message_tail(message_tail_sent, 0)
  :: pattern == 1 -> fill_message_tail(message_tail_sent, 32)
  :: pattern == 2 -> fill_message_tail(message_tail_sent, 255)
  :: else -> ramp_message_tail(message_tail_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_message_tail(message_tail_sent);
    assert(at == 4);
    at = 0;
    decode_message_tail(message_tail_got);
    assert(at == 4);
    equal_message_tail(message_tail_got, message_tail_sent)
  }
}

/* one checking process, chosen nondeterministically, so every one of them runs */
init {
  if
  :: run check_message_header()
  :: run check_logon_message()
  :: run check_logout_message()
  :: run check_business_reject_message()
  :: run check_platform_state_info_message()
  :: run check_report_finished_message()
