/* ---- Market Operation Ts Message: 63 bytes ----------------------------------- */

/* Market Operation TS. Reports per-issue when a Market Operation event occurs (halts, resumes, expirations). Information Category byte 3 selects market (K=KTB, B=Bonds, M=Baby Bonds, R=REPO, S=KOSPI, Q=KOSDAQ, X=KONEX, G=Gold, E=Emissions, F=Derivatives). */
typedef MarketOperationTsMessage {
  byte message_sequence_number[8];
  byte board_id[2];
  byte session_id[2];
  byte isin_code[12];
  byte a_designated_number_for_an_issue[6];
  byte processing_time_of_trading_system[12];
  byte board_event_id[3];
  byte start_time_of_a_board_event[9];
  byte board_event_group_code[5];
  byte trading_halt_reason_code[3];
  byte end_keyword
};

