/* what was read of Derivatives Batch Data Message is what was written, byte for byte */
inline equal_derivatives_batch_data_message(derivatives_batch_data_message_read, derivatives_batch_data_message_written) {
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 8 -> assert(derivatives_batch_data_message_read.message_sequence_number[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.message_sequence_number[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 6 -> assert(derivatives_batch_data_message_read.total_number_of_instruments_of_the_contract[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.total_number_of_instruments_of_the_contract[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 8 -> assert(derivatives_batch_data_message_read.business_date[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.business_date[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 12 -> assert(derivatives_batch_data_message_read.isin_code[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.isin_code[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 6 -> assert(derivatives_batch_data_message_read.a_designated_number_for_an_issue[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.a_designated_number_for_an_issue[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  assert(derivatives_batch_data_message_read.futures_options_type_code == derivatives_batch_data_message_written.futures_options_type_code);
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 11 -> assert(derivatives_batch_data_message_read.product_id[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.product_id[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 9 -> assert(derivatives_batch_data_message_read.abbreviated_issue_code[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.abbreviated_issue_code[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 80 -> assert(derivatives_batch_data_message_read.issue_name[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.issue_name[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 40 -> assert(derivatives_batch_data_message_read.abbreviated_issue_name[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.abbreviated_issue_name[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
  derivatives_batch_data_message_at = 0;
  do
  :: derivatives_batch_data_message_at < 80 -> assert(derivatives_batch_data_message_read.english_issue_name[derivatives_batch_data_message_at] == derivatives_batch_data_message_written.english_issue_name[derivatives_batch_data_message_at]); derivatives_batch_data_message_at = derivatives_batch_data_message_at + 1
  :: else -> break
  od;
