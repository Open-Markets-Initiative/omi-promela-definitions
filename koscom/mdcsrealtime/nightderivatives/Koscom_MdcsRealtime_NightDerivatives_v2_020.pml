  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_30_day[daily_disclosed_rfr_message_at] = wire[at]; at = at + 1; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
