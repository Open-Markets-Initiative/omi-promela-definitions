/* ---- Trade Trade Amendment Or Cancellation 2 Legs Private Information Message: 367 bytes ---- */

/* Sent by the server to inform about a trade produced due to any reason other than order matching, also to inform about trades produced due to order matching in a Dark pool. The user is involved in the trade both as Buyer and Seller */
typedef TradeTradeAmendmentOrCancellation2LegsPrivateInformationMessage {
  byte sequence_number[4];
  byte security_code[4];
  byte transaction_date_and_time[8];
  byte market_segment_id[4];
  byte trading_session_id;
  byte trd_match_id[4];
  byte trade_type;
  byte last_px[8];
  byte last_qty[4];
  byte gross_trade_amt[8];
  byte designation;
  byte market_mechanism;
  byte algo_flag;
  byte alt_last_px[8];
  byte accrued_interest_amt[8];
  byte accrued_interest_rate_p_8[8];
  byte settl_date[4];
  byte transaction_category;
  byte last_change_flag;
  byte benc_rfpt_flag;
  byte trade_price_condition;
  byte pre_trade_transparency_waiver;
  byte deferral_waiver;
  byte post_deferral_publication_type;
  byte publish_date_and_time[8];
  byte trade_date[8];
  byte trade_session_date[4];
  byte settl_date_2[4];
  byte end_cash[8];
  byte amended_trade_type;
  byte exec_ref_id[4];
  byte amended_trade_date[4];
  byte broker_trader[3];
  byte broker_text[15];
  byte secondary_order_id[4];
  byte entry_date[4];
  byte priority_[4];
  byte price[8];
  byte display_qty[4];
  byte alt_price[8];
  byte order_id[4];
  byte secondary_exec_id[4];
  byte order_qty[4];
  byte ord_status;
  byte ccp_code;
  byte aggressor_indicator;
  byte request_id[4];
  byte client_data_id[2];
  byte algorithmic_trade_indicator;
  byte client_id[4];
  byte account_bolsa[16];
  byte account[5];
  byte dea_flag;
  byte decisor_id[4];
  byte executor_id[4];
  byte liquidity_provision_activity;
  byte account_member[4];
  byte last_capacity;
  byte received_dept_id;
  byte persistence;
  byte member[4];
  byte trader[3];
  byte sub_member;
