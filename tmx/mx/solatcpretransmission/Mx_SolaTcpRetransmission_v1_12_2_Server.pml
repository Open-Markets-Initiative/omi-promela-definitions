  equal_long_message_header(circuit_assurance_message_read.long_message_header, circuit_assurance_message_written.long_message_header);
  circuit_assurance_message_at = 0;
  do
  :: circuit_assurance_message_at < 6 -> assert(circuit_assurance_message_read.time[circuit_assurance_message_at] == circuit_assurance_message_written.time[circuit_assurance_message_at]); circuit_assurance_message_at = circuit_assurance_message_at + 1
  :: else -> break
  od;
  skip
}

/* ---- What spin checks -------------------------------------------------------- */

/* 2 records: each encoded, read back, and compared */
proctype check_message_header() {
  MessageHeader message_header_sent;
  MessageHeader message_header_got;
  ErrorMessage error_message_sent;
  ErrorMessage error_message_got;
  int record;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: record = 0
  :: record = 1
  fi;

  if
  :: record == 0 ->
    if
    :: pattern == 0 -> fill_message_header(message_header_sent, 0)
    :: pattern == 1 -> fill_message_header(message_header_sent, 32)
    :: pattern == 2 -> fill_message_header(message_header_sent, 255)
    :: else -> ramp_message_header(message_header_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_message_header(message_header_sent);
      assert(at == 11);
      at = 0;
      decode_message_header(message_header_got);
      assert(at == 11);
      equal_message_header(message_header_got, message_header_sent)
    }

  :: else ->
    if
    :: pattern == 0 -> fill_error_message(error_message_sent, 0)
    :: pattern == 1 -> fill_error_message(error_message_sent, 32)
    :: pattern == 2 -> fill_error_message(error_message_sent, 255)
    :: else -> ramp_error_message(error_message_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_error_message(error_message_sent);
      assert(at == 84);
      at = 0;
      decode_error_message(error_message_got);
      assert(at == 84);
      equal_error_message(error_message_got, error_message_sent)
    }

  fi
}

/* 2 records: each encoded, read back, and compared */
proctype check_long_message_header() {
  LongMessageHeader long_message_header_sent;
  LongMessageHeader long_message_header_got;
  StrikePriceNegativeWholePair strike_price_negative_whole_pair_sent;
  StrikePriceNegativeWholePair strike_price_negative_whole_pair_got;
  int record;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: record = 0
  :: record = 1
  fi;

  if
  :: record == 0 ->
    if
    :: pattern == 0 -> fill_long_message_header(long_message_header_sent, 0)
    :: pattern == 1 -> fill_long_message_header(long_message_header_sent, 32)
    :: pattern == 2 -> fill_long_message_header(long_message_header_sent, 255)
    :: else -> ramp_long_message_header(long_message_header_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_long_message_header(long_message_header_sent);
      assert(at == 12);
      at = 0;
      decode_long_message_header(long_message_header_got);
      assert(at == 12);
      equal_long_message_header(long_message_header_got, long_message_header_sent)
    }

  :: else ->
    if
    :: pattern == 0 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 0)
    :: pattern == 1 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 32)
    :: pattern == 2 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 255)
    :: else -> ramp_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent);
      assert(at == 8);
      at = 0;
      decode_strike_price_negative_whole_pair(strike_price_negative_whole_pair_got);
      assert(at == 8);
      equal_strike_price_negative_whole_pair(strike_price_negative_whole_pair_got, strike_price_negative_whole_pair_sent)
    }

  fi
}

