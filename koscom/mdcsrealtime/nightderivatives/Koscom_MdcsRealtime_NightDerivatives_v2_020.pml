}

/* ---- Daily Disclosed Rfr Message: 82 bytes ----------------------------------- */

/* Daily disclosed Risk-Free Rate (RFR) reference. */
typedef DailyDisclosedRfrMessage {
  byte base_date[8];
  byte disclosure_type[2];
  byte disclosure_date[14];
  byte rfr[9];
  byte indexed_interest_rate[12];
  byte interest_rate_30_day[12];
  byte interest_rate_90_day[12];
  byte interest_rate_180_day[12];
  byte end_keyword
};

int daily_disclosed_rfr_message_at;

/* every byte of Daily Disclosed Rfr Message set to one value */
inline fill_daily_disclosed_rfr_message(daily_disclosed_rfr_message_record, daily_disclosed_rfr_message_value) {
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 8 -> daily_disclosed_rfr_message_record.base_date[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 2 -> daily_disclosed_rfr_message_record.disclosure_type[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 14 -> daily_disclosed_rfr_message_record.disclosure_date[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 9 -> daily_disclosed_rfr_message_record.rfr[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.indexed_interest_rate[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> daily_disclosed_rfr_message_record.interest_rate_30_day[daily_disclosed_rfr_message_at] = daily_disclosed_rfr_message_value; daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
