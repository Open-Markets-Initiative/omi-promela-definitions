  :: else -> break
  od;
  simple_order_status_message_at = 0;
  do
  :: simple_order_status_message_at < 4 -> simple_order_status_message_record.security_code[simple_order_status_message_at] = simple_order_status_message_value; simple_order_status_message_at = simple_order_status_message_at + 1
  :: else -> break
  od;
