/* ---- What spin checks -------------------------------------------------------- */

/* 2 records: each encoded, read back, and compared */
proctype check_message_header() {
  MessageHeader message_header_sent;
  MessageHeader message_header_got;
  StrikePriceInstrumentNegativeWholePair strike_price_instrument_negative_whole_pair_sent;
  StrikePriceInstrumentNegativeWholePair strike_price_instrument_negative_whole_pair_got;
  int record;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: record = 0
  :: record = 1
  fi;

  if
  :: record == 0 ->
    if
    :: pattern == 0 -> fill_message_header(message_header_sent, 0)
    :: pattern == 1 -> fill_message_header(message_header_sent, 32)
    :: pattern == 2 -> fill_message_header(message_header_sent, 255)
    :: else -> ramp_message_header(message_header_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_message_header(message_header_sent);
      assert(at == 11);
      at = 0;
      decode_message_header(message_header_got);
      assert(at == 11);
      equal_message_header(message_header_got, message_header_sent)
    }

  :: else ->
    if
    :: pattern == 0 -> fill_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_sent, 0)
    :: pattern == 1 -> fill_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_sent, 32)
    :: pattern == 2 -> fill_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_sent, 255)
    :: else -> ramp_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_sent);
      assert(at == 8);
      at = 0;
      decode_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_got);
      assert(at == 8);
      equal_strike_price_instrument_negative_whole_pair(strike_price_instrument_negative_whole_pair_got, strike_price_instrument_negative_whole_pair_sent)
    }

  fi
}

