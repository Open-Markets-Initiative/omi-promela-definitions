/* ---- Derivatives Order Filled Message: 168 bytes ----------------------------- */

/* Derivatives Order Filled. Real-time trade prints with running totals for futures and options. */
typedef DerivativesOrderFilledMessage {
  byte message_sequence_number[8];
  byte board_id[2];
  byte session_id[2];
  byte isin_code[12];
  byte a_designated_number_for_an_issue[6];
  byte processing_time_of_trading_system[12];
  byte trading_price[9];
  byte trading_volume[9];
  byte nearby_month_contract_trading_price[9];
  byte distant_month_contract_trading_price[9];
  byte opening_price[9];
  byte todays_high[9];
  byte todays_low[9];
  byte previous_price[9];
  byte accumulated_trading_volume[12];
  byte accumulated_trading_value[22];
  byte final_ask_bid_type_code;
  byte upper_limit_of_dynamic_price_range[9];
  byte lower_limit_of_dynamic_price_range[9];
  byte end_keyword
};

int derivatives_order_filled_message_at;

/* every byte of Derivatives Order Filled Message set to one value */
