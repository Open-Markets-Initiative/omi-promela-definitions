  error_message_at = 0;
  do
  :: error_message_at < 80 -> wire[at] = error_message_record.error_msg[error_message_at]; at = at + 1; error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

/* Error Message off the wire, 84 bytes from where the cursor stands */
