/*
 * TMX Group Sola Tcp Retransmission
 *
 * Generated from the binary model. Every record is a run of fields, and spin checks the two
 * claims the model's rules call for: that encoding a record writes the bytes its fields say,
 * and that decoding those bytes gives the record back and consumes exactly what was written.
 *
 * A field is the bytes it occupies. Nothing is read as an integer: spin evaluates an int in
 * 32 bits, as TLC does, so a field wider than that has no range a checker could enumerate,
 * and bytes are exact at any width. No rule stated here depends on a value.
 *
 * Each record is checked at four patterns: every byte zero, every byte the space a text
 * field pads with, every byte with all bits set, and the ramp - each byte holding where it
 * lies, which is what catches a field written or read out of place.
 *
 * What this definition does not state, and the model does:
 *   - a run filling what frames it
 *   - the dispatch that chooses a message by its type
 *   - a run counted by a field
 *
 * License: MIT No Attribution
 */

/* ---- The wire ---------------------------------------------------------------- */

/* the widest record this protocol states, which is the most a check writes at once */
#define WIRE 84

/* the bytes a record is written to and read back from */
byte wire[WIRE];

/* where the next byte is written or read, so a nested record carries on from its holder */
int at;

/* ---- Message Header: 12 bytes ------------------------------------------------ */

/* Standard Hsvf message header */
typedef MessageHeader {
  byte sequence_number[10];
  byte message_type[2]
};

int message_header_at;

/* every byte of Message Header set to one value */
inline fill_message_header(message_header_record, message_header_value) {
  message_header_at = 0;
  do
  :: message_header_at < 10 -> message_header_record.sequence_number[message_header_at] = message_header_value; message_header_at = message_header_at + 1
  :: else -> break
  od;
  message_header_at = 0;
  do
  :: message_header_at < 2 -> message_header_record.message_type[message_header_at] = message_header_value; message_header_at = message_header_at + 1
  :: else -> break
  od;
  skip
}

/* each byte of Message Header set to where it lies, so a field read out of place says so */
inline ramp_message_header(message_header_record, message_header_base) {
  message_header_at = 0;
  do
  :: message_header_at < 10 -> message_header_record.sequence_number[message_header_at] = (message_header_base + 0 + message_header_at + 1) % 256; message_header_at = message_header_at + 1
  :: else -> break
  od;
  message_header_at = 0;
  do
  :: message_header_at < 2 -> message_header_record.message_type[message_header_at] = (message_header_base + 10 + message_header_at + 1) % 256; message_header_at = message_header_at + 1
  :: else -> break
  od;
  skip
}

/* Message Header to the wire, 12 bytes from where the cursor stands */
inline encode_message_header(message_header_record) {
  message_header_at = 0;
  do
  :: message_header_at < 10 -> wire[at] = message_header_record.sequence_number[message_header_at]; at = at + 1; message_header_at = message_header_at + 1
  :: else -> break
  od;
  message_header_at = 0;
  do
  :: message_header_at < 2 -> wire[at] = message_header_record.message_type[message_header_at]; at = at + 1; message_header_at = message_header_at + 1
  :: else -> break
  od;
  skip
}

/* Message Header off the wire, 12 bytes from where the cursor stands */
inline decode_message_header(message_header_record) {
  message_header_at = 0;
  do
  :: message_header_at < 10 -> message_header_record.sequence_number[message_header_at] = wire[at]; at = at + 1; message_header_at = message_header_at + 1
  :: else -> break
  od;
  message_header_at = 0;
  do
  :: message_header_at < 2 -> message_header_record.message_type[message_header_at] = wire[at]; at = at + 1; message_header_at = message_header_at + 1
  :: else -> break
  od;
  skip
}

/* what was read of Message Header is what was written, byte for byte */
inline equal_message_header(message_header_read, message_header_written) {
  message_header_at = 0;
  do
  :: message_header_at < 10 -> assert(message_header_read.sequence_number[message_header_at] == message_header_written.sequence_number[message_header_at]); message_header_at = message_header_at + 1
  :: else -> break
  od;
  message_header_at = 0;
  do
  :: message_header_at < 2 -> assert(message_header_read.message_type[message_header_at] == message_header_written.message_type[message_header_at]); message_header_at = message_header_at + 1
  :: else -> break
  od;
  skip
}

/* ---- Error Message: 84 bytes ------------------------------------------------- */

/* Error Message */
typedef ErrorMessage {
  byte error_code[4];
  byte error_msg[80]
};

int error_message_at;

/* every byte of Error Message set to one value */
inline fill_error_message(error_message_record, error_message_value) {
  error_message_at = 0;
  do
  :: error_message_at < 4 -> error_message_record.error_code[error_message_at] = error_message_value; error_message_at = error_message_at + 1
  :: else -> break
  od;
  error_message_at = 0;
  do
  :: error_message_at < 80 -> error_message_record.error_msg[error_message_at] = error_message_value; error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

/* each byte of Error Message set to where it lies, so a field read out of place says so */
inline ramp_error_message(error_message_record, error_message_base) {
  error_message_at = 0;
  do
  :: error_message_at < 4 -> error_message_record.error_code[error_message_at] = (error_message_base + 0 + error_message_at + 1) % 256; error_message_at = error_message_at + 1
  :: else -> break
  od;
  error_message_at = 0;
  do
  :: error_message_at < 80 -> error_message_record.error_msg[error_message_at] = (error_message_base + 4 + error_message_at + 1) % 256; error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

/* Error Message to the wire, 84 bytes from where the cursor stands */
inline encode_error_message(error_message_record) {
  error_message_at = 0;
  do
  :: error_message_at < 4 -> wire[at] = error_message_record.error_code[error_message_at]; at = at + 1; error_message_at = error_message_at + 1
  :: else -> break
  od;
  error_message_at = 0;
  do
  :: error_message_at < 80 -> wire[at] = error_message_record.error_msg[error_message_at]; at = at + 1; error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

/* Error Message off the wire, 84 bytes from where the cursor stands */
inline decode_error_message(error_message_record) {
  error_message_at = 0;
  do
  :: error_message_at < 4 -> error_message_record.error_code[error_message_at] = wire[at]; at = at + 1; error_message_at = error_message_at + 1
  :: else -> break
  od;
  error_message_at = 0;
  do
  :: error_message_at < 80 -> error_message_record.error_msg[error_message_at] = wire[at]; at = at + 1; error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

/* what was read of Error Message is what was written, byte for byte */
inline equal_error_message(error_message_read, error_message_written) {
  error_message_at = 0;
  do
  :: error_message_at < 4 -> assert(error_message_read.error_code[error_message_at] == error_message_written.error_code[error_message_at]); error_message_at = error_message_at + 1
  :: else -> break
  od;
  error_message_at = 0;
  do
  :: error_message_at < 80 -> assert(error_message_read.error_msg[error_message_at] == error_message_written.error_msg[error_message_at]); error_message_at = error_message_at + 1
  :: else -> break
  od;
  skip
}

