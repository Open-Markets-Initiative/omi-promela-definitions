  :: else -> break
  od;
  assert(emissions_market_operation_schedule_message_read.end_keyword == emissions_market_operation_schedule_message_written.end_keyword);
  skip
}

/* ---- Spot Gold Random End Message: 30 bytes ---------------------------------- */

/* Spot Gold Random End. Reports random extension of the call auction window when conditional random-end is triggered. */
typedef SpotGoldRandomEndMessage {
  byte message_sequence_number[8];
  byte board_id[2];
  byte isin_code[12];
  byte a_designated_number_for_an_issue[6];
  byte random_end_trigger_code;
  byte end_keyword
};

int spot_gold_random_end_message_at;

/* every byte of Spot Gold Random End Message set to one value */
inline fill_spot_gold_random_end_message(spot_gold_random_end_message_record, spot_gold_random_end_message_value) {
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 8 -> spot_gold_random_end_message_record.message_sequence_number[spot_gold_random_end_message_at] = spot_gold_random_end_message_value; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 2 -> spot_gold_random_end_message_record.board_id[spot_gold_random_end_message_at] = spot_gold_random_end_message_value; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 12 -> spot_gold_random_end_message_record.isin_code[spot_gold_random_end_message_at] = spot_gold_random_end_message_value; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 6 -> spot_gold_random_end_message_record.a_designated_number_for_an_issue[spot_gold_random_end_message_at] = spot_gold_random_end_message_value; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_record.random_end_trigger_code = spot_gold_random_end_message_value;
  spot_gold_random_end_message_record.end_keyword = spot_gold_random_end_message_value;
  skip
}

/* each byte of Spot Gold Random End Message set to where it lies, so a field read out of place says so */
inline ramp_spot_gold_random_end_message(spot_gold_random_end_message_record, spot_gold_random_end_message_base) {
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 8 -> spot_gold_random_end_message_record.message_sequence_number[spot_gold_random_end_message_at] = (spot_gold_random_end_message_base + 0 + spot_gold_random_end_message_at + 1) % 256; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 2 -> spot_gold_random_end_message_record.board_id[spot_gold_random_end_message_at] = (spot_gold_random_end_message_base + 8 + spot_gold_random_end_message_at + 1) % 256; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 12 -> spot_gold_random_end_message_record.isin_code[spot_gold_random_end_message_at] = (spot_gold_random_end_message_base + 10 + spot_gold_random_end_message_at + 1) % 256; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 6 -> spot_gold_random_end_message_record.a_designated_number_for_an_issue[spot_gold_random_end_message_at] = (spot_gold_random_end_message_base + 22 + spot_gold_random_end_message_at + 1) % 256; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_record.random_end_trigger_code = (spot_gold_random_end_message_base + 28 + 1) % 256;
  spot_gold_random_end_message_record.end_keyword = (spot_gold_random_end_message_base + 29 + 1) % 256;
  skip
}

/* Spot Gold Random End Message to the wire, 30 bytes from where the cursor stands */
inline encode_spot_gold_random_end_message(spot_gold_random_end_message_record) {
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 8 -> wire[at] = spot_gold_random_end_message_record.message_sequence_number[spot_gold_random_end_message_at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 2 -> wire[at] = spot_gold_random_end_message_record.board_id[spot_gold_random_end_message_at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 12 -> wire[at] = spot_gold_random_end_message_record.isin_code[spot_gold_random_end_message_at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 6 -> wire[at] = spot_gold_random_end_message_record.a_designated_number_for_an_issue[spot_gold_random_end_message_at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  wire[at] = spot_gold_random_end_message_record.random_end_trigger_code; at = at + 1;
  wire[at] = spot_gold_random_end_message_record.end_keyword; at = at + 1;
  skip
}

/* Spot Gold Random End Message off the wire, 30 bytes from where the cursor stands */
inline decode_spot_gold_random_end_message(spot_gold_random_end_message_record) {
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 8 -> spot_gold_random_end_message_record.message_sequence_number[spot_gold_random_end_message_at] = wire[at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 2 -> spot_gold_random_end_message_record.board_id[spot_gold_random_end_message_at] = wire[at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 12 -> spot_gold_random_end_message_record.isin_code[spot_gold_random_end_message_at] = wire[at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 6 -> spot_gold_random_end_message_record.a_designated_number_for_an_issue[spot_gold_random_end_message_at] = wire[at]; at = at + 1; spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_record.random_end_trigger_code = wire[at]; at = at + 1;
  spot_gold_random_end_message_record.end_keyword = wire[at]; at = at + 1;
  skip
}

/* what was read of Spot Gold Random End Message is what was written, byte for byte */
inline equal_spot_gold_random_end_message(spot_gold_random_end_message_read, spot_gold_random_end_message_written) {
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 8 -> assert(spot_gold_random_end_message_read.message_sequence_number[spot_gold_random_end_message_at] == spot_gold_random_end_message_written.message_sequence_number[spot_gold_random_end_message_at]); spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 2 -> assert(spot_gold_random_end_message_read.board_id[spot_gold_random_end_message_at] == spot_gold_random_end_message_written.board_id[spot_gold_random_end_message_at]); spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 12 -> assert(spot_gold_random_end_message_read.isin_code[spot_gold_random_end_message_at] == spot_gold_random_end_message_written.isin_code[spot_gold_random_end_message_at]); spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  spot_gold_random_end_message_at = 0;
  do
  :: spot_gold_random_end_message_at < 6 -> assert(spot_gold_random_end_message_read.a_designated_number_for_an_issue[spot_gold_random_end_message_at] == spot_gold_random_end_message_written.a_designated_number_for_an_issue[spot_gold_random_end_message_at]); spot_gold_random_end_message_at = spot_gold_random_end_message_at + 1
  :: else -> break
  od;
  assert(spot_gold_random_end_message_read.random_end_trigger_code == spot_gold_random_end_message_written.random_end_trigger_code);
  assert(spot_gold_random_end_message_read.end_keyword == spot_gold_random_end_message_written.end_keyword);
  skip
}

/* ---- What spin checks -------------------------------------------------------- */

/* Polling Data Message: encoded, read back, and compared */
proctype check_polling_data_message() {
  PollingDataMessage polling_data_message_sent;
  PollingDataMessage polling_data_message_got;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: pattern == 0 -> fill_polling_data_message(polling_data_message_sent, 0)
  :: pattern == 1 -> fill_polling_data_message(polling_data_message_sent, 32)
  :: pattern == 2 -> fill_polling_data_message(polling_data_message_sent, 255)
  :: else -> ramp_polling_data_message(polling_data_message_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_polling_data_message(polling_data_message_sent);
    assert(at == 5);
    at = 0;
    decode_polling_data_message(polling_data_message_got);
    assert(at == 5);
    equal_polling_data_message(polling_data_message_got, polling_data_message_sent)
  }
}

