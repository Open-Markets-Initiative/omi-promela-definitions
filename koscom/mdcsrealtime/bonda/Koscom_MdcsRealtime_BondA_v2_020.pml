int repo_quote_message_at;

/* every byte of Repo Quote Message set to one value */
inline fill_repo_quote_message(repo_quote_message_record, repo_quote_message_value) {
  repo_quote_message_at = 0;
  do
  :: repo_quote_message_at < 8 -> repo_quote_message_record.message_sequence_number[repo_quote_message_at] = repo_quote_message_value; repo_quote_message_at = repo_quote_message_at + 1
  :: else -> break
  od;
  repo_quote_message_at = 0;
  do
  :: repo_quote_message_at < 2 -> repo_quote_message_record.board_id[repo_quote_message_at] = repo_quote_message_value; repo_quote_message_at = repo_quote_message_at + 1
  :: else -> break
  od;
  repo_quote_message_at = 0;
  do
  :: repo_quote_message_at < 2 -> repo_quote_message_record.session_id[repo_quote_message_at] = repo_quote_message_value; repo_quote_message_at = repo_quote_message_at + 1
  :: else -> break
  od;
  repo_quote_message_at = 0;
  do
  :: repo_quote_message_at < 12 -> repo_quote_message_record.isin_code[repo_quote_message_at] = repo_quote_message_value; repo_quote_message_at = repo_quote_message_at + 1
  :: else -> break
  od;
