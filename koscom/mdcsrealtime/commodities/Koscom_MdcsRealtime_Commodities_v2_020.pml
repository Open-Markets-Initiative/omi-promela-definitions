  byte index_id[6];
  byte isin_code[12];
  byte business_date[8];
  byte calculation_time[6];
  byte index[9];
  byte index_change_sign_against_the_previous_day;
  byte index_change_against_the_previous_day[9];
  byte currency_code[6];
  byte filler_4[4];
  byte end_keyword
};

