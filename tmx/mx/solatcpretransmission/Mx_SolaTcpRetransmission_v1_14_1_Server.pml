  :: record = 1
  fi;

  if
  :: record == 0 ->
    if
    :: pattern == 0 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 0)
    :: pattern == 1 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 32)
    :: pattern == 2 -> fill_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 255)
    :: else -> ramp_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_strike_price_negative_whole_pair(strike_price_negative_whole_pair_sent);
      assert(at == 8);
      at = 0;
      decode_strike_price_negative_whole_pair(strike_price_negative_whole_pair_got);
      assert(at == 8);
      equal_strike_price_negative_whole_pair(strike_price_negative_whole_pair_got, strike_price_negative_whole_pair_sent)
    }

  :: else ->
    if
    :: pattern == 0 -> fill_strike_price_negative_ten_pair(strike_price_negative_ten_pair_sent, 0)
    :: pattern == 1 -> fill_strike_price_negative_ten_pair(strike_price_negative_ten_pair_sent, 32)
    :: pattern == 2 -> fill_strike_price_negative_ten_pair(strike_price_negative_ten_pair_sent, 255)
    :: else -> ramp_strike_price_negative_ten_pair(strike_price_negative_ten_pair_sent, 0)
    fi;

    atomic {
      at = 0;
      encode_strike_price_negative_ten_pair(strike_price_negative_ten_pair_sent);
      assert(at == 8);
      at = 0;
      decode_strike_price_negative_ten_pair(strike_price_negative_ten_pair_got);
      assert(at == 8);
      equal_strike_price_negative_ten_pair(strike_price_negative_ten_pair_got, strike_price_negative_ten_pair_sent)
    }

  fi
}

