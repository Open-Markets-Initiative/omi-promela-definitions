  :: emissions_market_operation_schedule_message_at < 2 -> assert(emissions_market_operation_schedule_message_read.session_id[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.session_id[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
  emissions_market_operation_schedule_message_at = 0;
  do
  :: emissions_market_operation_schedule_message_at < 12 -> assert(emissions_market_operation_schedule_message_read.isin_code[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.isin_code[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
  emissions_market_operation_schedule_message_at = 0;
  do
  :: emissions_market_operation_schedule_message_at < 12 -> assert(emissions_market_operation_schedule_message_read.isin_code_of_a_common_stock[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.isin_code_of_a_common_stock[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
  emissions_market_operation_schedule_message_at = 0;
  do
  :: emissions_market_operation_schedule_message_at < 11 -> assert(emissions_market_operation_schedule_message_read.product_id[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.product_id[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
  emissions_market_operation_schedule_message_at = 0;
  do
  :: emissions_market_operation_schedule_message_at < 3 -> assert(emissions_market_operation_schedule_message_read.trading_halt_reason_code[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.trading_halt_reason_code[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
  assert(emissions_market_operation_schedule_message_read.trading_halt_type_code == emissions_market_operation_schedule_message_written.trading_halt_type_code);
  emissions_market_operation_schedule_message_at = 0;
  do
  :: emissions_market_operation_schedule_message_at < 2 -> assert(emissions_market_operation_schedule_message_read.step_applied[emissions_market_operation_schedule_message_at] == emissions_market_operation_schedule_message_written.step_applied[emissions_market_operation_schedule_message_at]); emissions_market_operation_schedule_message_at = emissions_market_operation_schedule_message_at + 1
  :: else -> break
  od;
