/* ---- Subscription Execution Report Message: 189 bytes ------------------------ */

/* Order response and cancel execution report for subscription, ApplID 043: confirms or rejects a new order; the business does not allow cancellation. Not yet enabled. */
typedef SubscriptionExecutionReportMessage {
  byte partition_no[4];
  byte report_index[8];
  byte appl_id[3];
  byte reporting_pbuid[6];
  byte submitting_pbuid[6];
  byte security_id[8];
  byte security_id_source[4];
  byte owner_type[2];
  byte clearing_firm[2];
  byte transact_time[8];
  byte user_info[32];
  byte order_id[16];
  byte cl_ord_id[10];
  byte orig_cl_ord_id[10];
  byte exec_id[16];
  byte exec_type;
  byte ord_status;
  byte ord_rej_reason[2];
  byte leaves_qty[8];
  byte cum_qty[8];
  byte side;
  byte ord_type;
  byte order_qty[8];
  byte price[8];
  byte account_id[10];
  byte branch_id[2];
  byte order_restrictions[4]
};

