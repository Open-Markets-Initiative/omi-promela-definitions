/* one checking process, chosen nondeterministically, so every one of them runs */
init {
  if
  :: run check_message_header()
  :: run check_strike_price_instrument_negative_ten_pair()
  :: run check_strike_price_instrument_negative_thousand_pair()
  :: run check_strike_price_instrument_negative_hundred_thousand_pair()
  :: run check_strike_price_instrument_numeric_pair()
  :: run check_trade_price_negative_ten_pair()
  :: run check_trade_price_negative_thousand_pair()
  :: run check_trade_price_negative_hundred_thousand_pair()
  :: run check_trade_price_numeric_pair()
  :: run check_net_change_negative_ten_pair()
  :: run check_net_change_negative_thousand_pair()
  :: run check_net_change_negative_hundred_thousand_pair()
  :: run check_net_change_numeric_pair()
  :: run check_net_change_future_options_trade_message_negative_ten_pair()
  :: run check_net_change_future_options_trade_message_negative_thousand_pair()
  :: run check_net_change_future_options_trade_message_negative_hundred_thousand_pair()
  :: run check_net_change_future_options_trade_message_numeric_pair()
  :: run check_net_change_futures_trade_message_negative_ten_pair()
  :: run check_net_change_futures_trade_message_negative_thousand_pair()
