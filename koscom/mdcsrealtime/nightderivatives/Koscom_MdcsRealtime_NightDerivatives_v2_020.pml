  do
  :: daily_disclosed_rfr_message_at < 9 -> assert(daily_disclosed_rfr_message_read.rfr[daily_disclosed_rfr_message_at] == daily_disclosed_rfr_message_written.rfr[daily_disclosed_rfr_message_at]); daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> assert(daily_disclosed_rfr_message_read.indexed_interest_rate[daily_disclosed_rfr_message_at] == daily_disclosed_rfr_message_written.indexed_interest_rate[daily_disclosed_rfr_message_at]); daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
  od;
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 12 -> assert(daily_disclosed_rfr_message_read.interest_rate_30_day[daily_disclosed_rfr_message_at] == daily_disclosed_rfr_message_written.interest_rate_30_day[daily_disclosed_rfr_message_at]); daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
  :: else -> break
