/* one checking process, chosen nondeterministically, so every one of them runs */
init {
  if
  :: run check_polling_data_message()
  :: run check_krx_index_message()
  :: run check_krx_estimated_index_message()
  :: run check_global_index_message()
  :: run check_bond_prime_index_message()
  :: run check_bond_ktb_index_message()
  :: run check_bond_ktb_index_term_structure_message()
  :: run check_bond_index_krx_message()
  :: run check_spot_gold_quote_message()
  :: run check_spot_gold_order_filled_message()
  :: run check_spot_gold_order_filled_plus_quote_message()
  :: run check_spot_gold_market_operation_ts_plus_quote_message()
  :: run check_spot_gold_snapshot_message()
  :: run check_spot_gold_negotiated_trade_message()
  :: run check_emissions_quote_message()
  :: run check_emissions_order_filled_message()
  :: run check_emissions_order_filled_plus_quote_message()
  :: run check_emissions_market_operation_ts_plus_quote_message()
  :: run check_emissions_snapshot_message()
  :: run check_emissions_negotiated_trade_message()
  :: run check_emissions_determination_of_base_price_message()
  :: run check_emissions_auction_results_message()
  :: run check_spot_gold_batch_data_message()
  :: run check_emissions_batch_data_message()
  :: run check_external_gold_spot_closing_price_message()
  :: run check_spot_gold_market_operation_ts_message()
  :: run check_spot_gold_issue_closing_message()
  :: run check_spot_gold_market_operation_schedule_message()
  :: run check_emissions_market_operation_ts_message()
  :: run check_emissions_issue_closing_message()
  :: run check_emissions_market_operation_schedule_message()
  :: run check_spot_gold_random_end_message()
  fi
}
