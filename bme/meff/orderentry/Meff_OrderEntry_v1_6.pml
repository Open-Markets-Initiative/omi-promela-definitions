/* Execution Private Information 1 Leg Sell Order Entry Message: encoded, read back, and compared */
proctype check_execution_private_information1_leg_sell_order_entry_message() {
  ExecutionPrivateInformation1LegSellOrderEntryMessage execution_private_information1_leg_sell_order_entry_message_sent;
  ExecutionPrivateInformation1LegSellOrderEntryMessage execution_private_information1_leg_sell_order_entry_message_got;
  int pattern;

  if
  :: pattern = 0
  :: pattern = 1
  :: pattern = 2
  :: pattern = 3
  fi;

  if
  :: pattern == 0 -> fill_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_sent, 0)
  :: pattern == 1 -> fill_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_sent, 32)
  :: pattern == 2 -> fill_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_sent, 255)
  :: else -> ramp_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_sent, 0)
  fi;

  atomic {
    at = 0;
    encode_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_sent);
    assert(at == 99);
    at = 0;
    decode_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_got);
    assert(at == 99);
    equal_execution_private_information1_leg_sell_order_entry_message(execution_private_information1_leg_sell_order_entry_message_got, execution_private_information1_leg_sell_order_entry_message_sent)
  }
}

