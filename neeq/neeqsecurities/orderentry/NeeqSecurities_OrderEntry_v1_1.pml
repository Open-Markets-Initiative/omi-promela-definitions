/* ---- Business Reject Message: 103 bytes -------------------------------------- */

/* Sent by the trading gateway when a submission fails a basic validity check, such as an unknown security code or a submission outside its time window. */
typedef BusinessRejectMessage {
  byte appl_id[3];
  byte transact_time[8];
  byte submitting_pbuid[6];
  byte security_id[8];
  byte security_id_source[4];
  byte ref_seq_num[8];
  byte ref_msg_type[4];
  byte business_reject_ref_id[10];
  byte business_reject_reason[2];
  byte business_reject_text[50]
};

