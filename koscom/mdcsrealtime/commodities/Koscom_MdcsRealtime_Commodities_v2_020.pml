  :: else -> break
  od;
  krx_index_message_at = 0;
  do
  :: krx_index_message_at < 22 -> wire[at] = krx_index_message_record.accumulated_trading_value[krx_index_message_at]; at = at + 1; krx_index_message_at = krx_index_message_at + 1
