}

/* what was read of Daily Disclosed Rfr Message is what was written, byte for byte */
inline equal_daily_disclosed_rfr_message(daily_disclosed_rfr_message_read, daily_disclosed_rfr_message_written) {
  daily_disclosed_rfr_message_at = 0;
  do
  :: daily_disclosed_rfr_message_at < 8 -> assert(daily_disclosed_rfr_message_read.base_date[daily_disclosed_rfr_message_at] == daily_disclosed_rfr_message_written.base_date[daily_disclosed_rfr_message_at]); daily_disclosed_rfr_message_at = daily_disclosed_rfr_message_at + 1
